<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="aikku">
  <head>
    <%= display_meta_tags site: @sitename, separator: '-', reverse: true %>
    <%= display_meta_tags description: "AÏKKU traduit les besoins clients en une solution logicielle simple, robuste et adaptée" %>

    <link rel="canonical" href="<%= request.original_url %>">

    <% fr_url = url_for(locale: :fr, only_path: false) %>
    <% en_url = url_for(locale: :en, only_path: false) %>
    <% if request.path == "/" %>
      <link rel="alternate" hreflang="fr" href="https://www.aikku.eu/">
      <link rel="alternate" hreflang="en" href="https://www.aikku.eu/en">
      <link rel="alternate" hreflang="x-default" href="https://www.aikku.eu/">
    <% else %>
      <link rel="alternate" hreflang="fr" href="<%= fr_url %>">
      <link rel="alternate" hreflang="en" href="<%= en_url %>">
    <% end %>
    <link rel="alternate" hreflang="x-default" href="https://www.aikku.eu/">

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="google-site-verification" content="sIvCFBNjrlwWZEXsghUKTNG0eircBmtKTktB7iaHH7A" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render 'partials/gtag' %>
  </head>
  <body class="flex flex-col justify-between min-h-screen">
    <%= render partial: "partials/navbar" %>
    <%= render partial: "partials/notification" %>
    <main class="mb-auto">
      <%= yield %>
    </main>
    <%= render partial: "partials/footer" %>
  </body>
</html>