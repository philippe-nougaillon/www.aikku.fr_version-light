<%
  set_meta_tags(
    title: "Bienvenue"
  )
%>
<div class="relative text-center w-full min-h-[200px] md:min-h-[300px] text-neutral-content p-10 lg:p-30  ">
  <%= image_tag "background/background.avif",
      class: "absolute inset-0 w-full h-full object-cover",
      alt: "image de fond avec des formes géométriques et des couleurs vives",
      fetchpriority: "high",
      loading: "eager" %>
  <div class="absolute inset-0 bg-black/50"></div>
  <div class="relative z-10 reveal delay-1 ">
    <h1 class="pt-6 md:pt-0 text-4xl lg:text-6xl ">
      Le <span class="text-gradient">digital</span> au service de vos besoins
    </h1>
    <p class="text-xl p-8 hidden md:block md:text-center lg:text-2xl text-primary-content ">
      AÏKKU traduit les besoins clients en une solution logicielle simple, robuste et adaptée
    </p>
  </div>
</div>
<section class="w-full text-secondary-content py-20 px-10 md:p-20 text-justify reveal delay-2">
  <h2 class="text-3xl lg:text-5xl text-center mb-12">
    Notre devise : <span class="text-gradient-reverse">AI for You</span>
  </h2>
  <p class="text-xl mb-3">
    Découvrez la     <span class="font-semibold">plateforme Aïkku</span> et nos logiciels développés pour le compte d'entités publiques, privées ou établissement de l'enseignement supérieur.
  </p>
  <p class="hidden md:block">
    La transformation digitale s’accompagne d’une évolution des processus métier. 
    L’accès instantané aux données, où que l’on soit, transforme les méthodes de travail. 
    L’intégration de l’Intelligence Artificielle permet d’optimiser ces processus en gagnant en rapidité, qualité et efficacité. 
    Pour être pertinente, sa mise en place doit être pensée avec les équipes métier.
  </p>
  <div class="flex justify-center">
    <%= link_to 'En savoir plus ...', services_path, 
        class: 'btn-gradient  mt-12 shadow-lg h-min transition-transform hover:scale-105 border-none' %>
  </div>
</section>
<div class="footer-wave">
  <svg viewBox="0 0 1200 62" preserveAspectRatio="none">
    <path d="
      M0,62
      Q300,2 600,32
      Q900,62 1200,32
      L1200,62
      L0,62
      Z
    " fill="#1f1f3d"/>
  </svg>
</div>
<section id="secteurs" class="w-full text-white px-10 py-20 md:p-20 bg-info">
  <h2 class="text-3xl lg:text-5xl text-center mb-12">
    Nos <span class="text-gradient">secteurs clés</span>
  </h2>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-16">    
        <div class="bg-white h-full border border-gray-100 rounded-xl overflow-hidden flex flex-col">
      <figure>
        <%= image_tag(
          "pharmadoc/pharma.avif",
          class: "w-full h-48 object-cover",
          alt: "Industrie pharmaceutique",
          loading: "lazy",
          width: 800,
          height: 450,
          sizes: "(max-width: 768px) 100vw, 25vw"
        ) %>
      </figure>
      <div class="card-body text-black flex flex-col flex-grow">
        <h2 class="card-title mb-4">
          Industrie pharmaceutique
        </h2>
        <p class="flex-grow">
          Optimisez la gestion documentaire et la conformité réglementaire de vos études cliniques grâce à l'IA.
        </p>
        <div class="card-actions mt-6">
          <%= link_to(
            'En savoir plus sur Aïkku Pharmadoc Analyzer',
            aikku_ia_path,
            class: 'btn btn-sm btn-gradient w-full shadow h-min'
          ) %>
        </div>
      </div>
    </div>
  
    <div class="bg-white h-full border border-gray-100 rounded-xl overflow-hidden flex flex-col">
      <figure>
        <%= image_tag(
          "misc/students.avif",
          class: "w-full h-48 object-cover",
          alt: "Étudiants",
          loading: "lazy",
          width: 800,
          height: 450,
          sizes: "(max-width: 768px) 100vw, 25vw"
        ) %>
      </figure>
      <div class="card-body text-black flex flex-col flex-grow">
        <h2 class="card-title mb-4">
          Formation supérieure
        </h2>
        <p class="flex-grow">
          Gérez toutes vos formations et vos salles avec une solution simple,
          abordable et personnalisable
        </p>
        <div class="card-actions mt-6">
          <%= link_to(
            'En savoir plus sur Aikku PLANN',
            aikku_plann_path,
            class: 'btn btn-sm btn-gradient w-full shadow h-min'
          ) %>
        </div>
      </div>
    </div>

    <div class="bg-white h-full border border-gray-100 rounded-xl overflow-hidden flex flex-col">
      <figure>
        <%= image_tag(
          "misc/communauté-communes.avif",
          class: "w-full h-48 object-cover",
          alt: "Village",
          loading: "lazy",
          width: 800,
          height: 450,
          sizes: "(max-width: 768px) 100vw, 25vw"
        ) %>
      </figure>
      <div class="card-body text-black flex flex-col flex-grow">
        <h2 class="card-title mb-4">
          Collectivité locale
        </h2>
        <p class="flex-grow">
          Gérez facilement la coopération et la mutualisation des services
          et ressources de votre intercommunalité (EPCI)
        </p>
        <div class="card-actions mt-6">
          <%= link_to(
            'En savoir plus sur COOPCOMM',
            coopcomm_path,
            class: 'btn btn-sm btn-gradient w-full shadow h-min'
          ) %>
        </div>
      </div>
    </div>

    <div class="bg-white h-full border border-gray-100 rounded-xl overflow-hidden flex flex-col">
      <figure>
        <%= image_tag(
          "misc/periscolaire.avif",
          class: "w-full h-48 object-cover",
          alt: "Enfants en activité périscolaire",
          loading: "lazy",
          width: 800,
          height: 450,
          sizes: "(max-width: 768px) 100vw, 25vw"
        ) %>
      </figure>
      <div class="card-body text-black flex flex-col flex-grow">
        <h2 class="card-title mb-4">
          Services périscolaires & Enfance
        </h2>
        <p class="flex-grow">
          Simplifiez la gestion, la réservation et la facturation de vos activités périscolaires.
        </p>
        <div class="card-actions mt-6">
          <%= link_to(
            'En savoir plus sur PrestoFacto',
            presto_facto_path,
            class: 'btn btn-sm btn-gradient w-full shadow h-min'
          ) %>
        </div>
      </div>
    </div>
    
  </div>
</section>
<div class="footer-wave">
  <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
    <path d="
      M0,0
      Q300,60 600,30
      Q900,0 1200,30
      L1200,0
      L0,0
      Z
    " fill="#1f1f3d"/>
  </svg>
</div>
<section id="expérience" class="px-10 py-20 md:p-20">
  <h2 class="text-3xl text-center lg:text-5xl  mb-12">Une expérience de plus de 20 ans</h2>
  <p class="lg:text-2xl text-center">
    Aïkku est une société récente, mais ses fondateurs travaillent ensemble depuis plus de 20 ans.
    <br>
    Ensemble, ils ont construits de nombreux projets validés, dans le secteur de la santé, 
    <br>
    pour des clients tels que <span class="font-semibold">Sanofi</span> (eCRF), <span class="font-semibold">L’Oréal</span> (ePRO), <span class="font-semibold">PPRS Research</span> (CDMS), <span class="font-semibold">AirJin</span> (IoT)
  </p>
</section>

<div class="footer-wave">
  <svg viewBox="0 0 1200 62" preserveAspectRatio="none">
    <path d="M0,62 Q300,2 600,32 Q900,62 1200,32 L1200,62 L0,62 Z" fill="#1f1f3d"/>
  </svg>
</div>

<section id="salon-des-maires" class="w-full bg-info text-white px-6 py-16 md:px-20 md:py-20">
  <h2 class="text-3xl lg:text-5xl text-center mb-12">
    Retrouvez-nous au 
    <a href="https://www.salondesmaires.com/" target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-4 decoration-white/50">
      <span class="text-gradient">Salon des Maires</span>
    </a> 
    du 24 au 26 novembre
  </h2>

  <div class="max-w-6xl mx-auto bg-white text-black rounded-xl overflow-hidden flex flex-col md:flex-row items-stretch shadow-lg p-6 md:p-8 gap-6 md:gap-10">

    <div class="w-full md:w-1/2 shrink-0 overflow-hidden rounded-lg">
      <%= image_tag "salon.webp",
          class: "w-full h-full object-cover object-center rounded-lg shadow-sm transform hover:scale-105 transition-transform duration-300",
          alt: "Aïkku au Salon des Maires et des Collectivités Locales, Paris Porte de Versailles",
          loading: "lazy",
          width: 800,
          height: 450 %>
    </div>

    <div class="flex flex-col justify-center flex-1 min-w-0">
      <h3 class="text-2xl lg:text-3xl font-bold mb-4 leading-tight">
        Aïkku sera présent au <a href="https://www.salondesmaires.com/" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">Salon des Maires et des Collectivités Locales</a>
      </h3>
      
      <p class="mb-4 text-gray-700 leading-relaxed">
        Dans le cadre de l'engagement d'<span class="font-semibold text-black">Aïkku</span> auprès des collectivités territoriales, notre équipe aura le plaisir d'échanger avec vous sur nos solutions et services innovants.
      </p>
      
      <p class="text-gray-700 leading-relaxed">
        L'équipe <span class="font-semibold text-black">Aïkku</span> sera ravie de vous accueillir au <span class="font-semibold text-primary">Pavillon 7.3</span>, <span class="font-semibold text-primary">Stand G.24</span>.
      </p>
      
      <div class="mt-6 font-medium text-primary">
        Au plaisir de vous y retrouver !
      </div>
    </div>

  </div>
</section>

<div class="footer-wave">
  <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
    <path d="M0,0 Q300,60 600,30 Q900,0 1200,30 L1200,0 L0,0 Z" fill="#1f1f3d"/>
  </svg>
</div>


<section id="clients" class="flex flex-col justify-center p-15 overflow-hidden">
  <h2 class="text-center text-3xl lg:text-5xl mb-12">
    Ils nous font <span class="text-gradient">confiance</span>
  </h2>

  <div class="relative w-full overflow-hidden group">
    <div class="flex flex-nowrap items-center gap-8 w-max animate-marquee-horizontal">
      <% [
        { url: "https://www.cc-madetmoselle.fr/", logo: "logos/madmoselle.avif", alt: "Mad & Moselle logo" },
        { url: "https://www.grohe.com", logo: "logos/grohe.avif", alt: "GROHE logo" },
        { url: "https://www.iae-paris.com", logo: "logos/iaelogo.avif", alt: "IAE Paris-Sorbonne logo" },
        { url: "https://www.fnaut.fr/", logo: "logos/fnaut.avif", alt: "Logo FNAUT" },
        { url: "https://www.infogene.fr", logo: "logos/infogene.avif", alt: "Infogene logo" }
      ].tap { |list| break list + list }.each do |client| %>
        <div class="w-64 h-64 rounded flex items-center shrink-0">
          <%= link_to client[:url], target: "_blank", rel: "noopener" do %>
            <%= image_tag client[:logo], class: "mx-auto p-8", alt: client[:alt] %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>
