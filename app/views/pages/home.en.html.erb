<%
  set_meta_tags(
    title: "Bienvenue"
  )
%>

<div class="relative text-center w-full min-h-[200px] md:min-h-[300px] text-neutral-content p-10 lg:p-30">
  <%= image_tag "background/contact.avif",
      class: "absolute inset-0 w-full h-full object-cover bg-cover bg-center",
      alt: "background image with two hands shaking",
      fetchpriority: "high",
      loading: "eager" %>
  <div class="absolute inset-0 bg-black/50"></div>
  <div class="relative z-10 reveal delay-1">
    <h1 class="pt-6 md:pt-0 text-4xl lg:text-6xl">
      Digital <span class="text-gradient">solutions</span> serving your needs
    </h1>
    <p class="text-xl p-8 hidden md:block md:text-center lg:text-2xl text-primary-content">
      AÏKKU translates customer needs into simple, robust, and tailored software solutions
    </p>
  </div>
</div>

<section class="w-full text-secondary-content py-20 px-10 md:p-20 text-justify reveal delay-2">
  <h2 class="text-3xl lg:text-5xl text-center mb-12">
    Our motto : <span class="text-gradient-reverse">AI for You</span>
  </h2>
  <p class="text-xl mb-3">
    Discover the <span class="font-semibold">Aïkku platform</span> and our software solutions developed for public institutions, private organizations, and higher education establishments.
  </p>
  <p class="hidden md:block">
    Digital transformation goes hand in hand with the evolution of business processes. 
    Instant access to data, from anywhere, is transforming the way we work. 
    The integration of Artificial Intelligence helps optimize these processes, improving speed, quality, and efficiency. 
    For it to be truly effective, its implementation must be designed in collaboration with operational teams.
  </p>
  <div class="flex justify-center">
    <%= link_to 'Learn more ...', services_path, 
        class: 'btn-gradient mt-12 shadow-lg h-min transition-transform hover:scale-105 border-none' %>
  </div>
</section>

<div class="footer-wave">
  <svg viewBox="0 0 1200 62" preserveAspectRatio="none">
    <path d="
      M0,62
      Q300,2 600,32
      Q900,62 1200,32
      L1200,62
      L0,62
      Z
    " fill="#1f1f3d"/>
  </svg>
</div>

<section id="secteurs" class="w-full text-white px-10 py-20 md:p-20 bg-info">
  <h2 class="text-3xl lg:text-5xl text-center mb-12">
    Our <span class="text-gradient">key sectors</span>
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-16">
    
    <div class="bg-white h-full border border-gray-100 rounded-xl overflow-hidden flex flex-col">
      <figure>
        <%= image_tag(
          "pharmadoc/pharma.avif",
          class: "w-full h-48 object-cover",
          alt: "Pharmaceutical industry",
          loading: "lazy",
          width: 800,
          height: 450,
          sizes: "(max-width: 768px) 100vw, 25vw"
        ) %>
      </figure>
      <div class="card-body text-black flex flex-col flex-grow">
        <h2 class="card-title mb-4">
          Pharmaceutical Industry
        </h2>
        <p class="flex-grow">
          Optimize document management and regulatory compliance for your clinical studies with integrated AI
        </p>
        <div class="card-actions mt-6">
          <%= link_to(
            'Learn more about Aïkku Pharmadoc Analyzer',
            aikku_ia_path,
            class: 'btn btn-sm btn-gradient w-full shadow h-min'
          ) %>
        </div>
      </div>
    </div>

    <div class="bg-white h-full border border-gray-100 rounded-xl overflow-hidden flex flex-col">
      <figure>
        <%= image_tag(
          "misc/students.avif",
          class: "w-full h-48 object-cover",
          alt: "Students",
          loading: "lazy",
          width: 800,
          height: 450,
          sizes: "(max-width: 768px) 100vw, 25vw"
        ) %>
      </figure>
      <div class="card-body text-black flex flex-col flex-grow">
        <h2 class="card-title mb-4">
          Higher education
        </h2>
        <p class="flex-grow">
          Manage all your training programs and classrooms with a simple, affordable, and customizable solution
        </p>
        <div class="card-actions mt-6">
          <%= link_to(
            'Learn more about Aikku PLANN',
            aikku_plann_path,
            class: 'btn btn-sm btn-gradient w-full shadow h-min'
          ) %>
        </div>
      </div>
    </div>

    <div class="bg-white h-full border border-gray-100 rounded-xl overflow-hidden flex flex-col">
      <figure>
        <%= image_tag(
          "misc/communauté-communes.avif",
          class: "w-full h-48 object-cover",
          alt: "Village",
          loading: "lazy",
          width: 800,
          height: 450,
          sizes: "(max-width: 768px) 100vw, 25vw"
        ) %>
      </figure>
      <div class="card-body text-black flex flex-col flex-grow">
        <h2 class="card-title mb-4">
          Local authorities
        </h2>
        <p class="flex-grow">
          Effortlessly manage cooperation and resource sharing within your inter-municipal structure (EPCI)
        </p>
        <div class="card-actions mt-6">
          <%= link_to(
            'Learn more about Aikku COOPCOMM',
            aikku_coopcomm_path,
            class: 'btn btn-sm btn-gradient w-full shadow h-min'
          ) %>
        </div>
      </div>
    </div>

    <div class="bg-white h-full border border-gray-100 rounded-xl overflow-hidden flex flex-col">
      <figure>
        <%= image_tag(
          "misc/periscolaire.avif",
          class: "w-full h-48 object-cover",
          alt: "Children in after-school activity",
          loading: "lazy",
          width: 800,
          height: 450,
          sizes: "(max-width: 768px) 100vw, 25vw"
        ) %>
      </figure>
      <div class="card-body text-black flex flex-col flex-grow">
        <h2 class="card-title mb-4">
          Extracurricular & Childcare Services
        </h2>
        <p class="flex-grow">
          Simplify the management, booking, and invoicing for your extracurricular activities.
        </p>
        <div class="card-actions mt-6">
          <%= link_to(
            'Learn more about PrestoFacto',
            presto_facto_path,
            class: 'btn btn-sm btn-gradient w-full shadow h-min'
          ) %>
        </div>
      </div>
    </div>

  </div>
</section>

<div class="footer-wave">
  <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
    <path d="
      M0,0
      Q300,60 600,30
      Q900,0 1200,30
      L1200,0
      L0,0
      Z
    " fill="#1f1f3d"/>
  </svg>
</div>

<section id="expérience" class="px-10 py-20 md:p-20">
  <h2 class="text-3xl text-center lg:text-5xl mb-12">Over 20 years of experience</h2>
  <p class="lg:text-2xl text-center">
    Aïkku is a young company, but its founders have been working together for over 20 years.
    <br>
    Together, they have delivered numerous validated projects in the healthcare sector,
    <br>
    for clients such as <span class="font-semibold">Sanofi</span> (eCRF), <span class="font-semibold">L’Oréal</span> (ePRO), <span class="font-semibold">PPRS Research</span> (CDMS), <span class="font-semibold">AirJin</span> (IoT)
  </p>
</section>

<section id="clients" class="flex flex-col justify-center p-15 overflow-hidden">
  <h2 class="text-center text-3xl lg:text-5xl mb-12">
    Ils nous font <span class="text-gradient">confiance</span>
  </h2>

  <div class="relative w-full overflow-hidden group">
    <div class="flex flex-nowrap items-center gap-8 w-max animate-marquee-horizontal">
      <% [
        { url: "https://www.madmoselle.com", logo: "logos/madmoselle.avif", alt: "Mad & Moselle logo" },
        { url: "https://www.grohe.com", logo: "logos/grohe.avif", alt: "GROHE logo" },
        { url: "https://www.iae-paris.com", logo: "logos/iaelogo.avif", alt: "IAE Paris-Sorbonne logo" },
        { url: "https://www.fnaut.fr/", logo: "logos/fnaut.avif", alt: "Logo FNAUT" },
        { url: "https://www.infogene.fr", logo: "logos/infogene.avif", alt: "Infogene logo" }
      ].tap { |list| break list + list }.each do |client| %>
        <div class="w-64 h-64 rounded flex items-center shrink-0">
          <%= link_to client[:url], target: "_blank", rel: "noopener" do %>
            <%= image_tag client[:logo], class: "mx-auto p-8", alt: client[:alt] %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>