<!-- SECTION HERO -->
<div class="text-center reveal delay-1 m-8 md:m-30 flex flex-col lg:flex-row items-center gap-6 md:gap-16">
  <div class="flex-1 text-center lg:text-left reveal">
    <h1 class="text-5xl md:text-7xl text-secondary mb-8 leading-tight italic tracking-tight lg:whitespace-nowrap">
      <%= title "Pharmadoc Analyzer" %>
    </h1>
    <p class="text-xl lg:text-2xl text-gray-600 mb-10 leading-relaxed text-justify">
      <span class="text-secondary font-semibold">Pharmadoc Analyzer</span> est une 
      <span class="font-semibold">intelligence artificielle 100% française et souveraine</span>, 
      conçue pour l'industrie pharmaceutique afin de sécuriser et d'accélérer le contrôle qualité documentaire des études cliniques. 
      Elle est capable d'analyser tout type de document réglementaire grâce à un modèle d'IA sur mesure, dédié à chaque entreprise.
    </p>
  </div>

  <div class="flex-1 w-full max-w-xl reveal delay-1">
    <div class="relative group">
      <div class="absolute -inset-4 bg-gradient-to-r from-blue-400 to-purple-600 rounded-full blur-xl opacity-10 group-hover:opacity-20 transition duration-1000"></div>
      <%= image_tag "logos/logopharma.png", 
            width: 1200, 
            height: 900, 
            loading: "lazy", 
            alt: "Aïkku Pharmadoc Analyzer Logo", 
            class: "relative bg-white shadow-xl rounded-3xl animate-pulsing" %>
    </div>
  </div>
</div>

<div class="footer-wave">
  <svg viewBox="0 0 1200 62" preserveAspectRatio="none">
    <path d="M0,62 Q300,2 600,32 Q900,62 1200,32 L1200,62 L0,62 Z" fill="#1f1f3d"/>
  </svg>
</div>

<section id="cas-usage" class="w-full bg-[#1f1f3d] text-white py-24 px-6 md:px-12">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-20">
      <h2 class="text-4xl lg:text-6xl  mb-6">
        Les trois majeurs <span class="text-gradient"> impacts </span> 
      </h2>
    </div>

    <!-- Layout Grid : 2 columnas en Tablet/Desktop con el 3er elemento centrado al medio -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Card 1 -->
      <div class="group p-8 lg:p-10 rounded-3xl bg-white/5 border border-white/10 hover:bg-white/10 hover:border-[#51c7fd]/50 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex flex-row items-center gap-4 mb-6">
            <div class="w-14 h-14 shrink-0 flex items-center justify-center rounded-2xl bg-[#51c7fd]/10 group-hover:scale-110 group-hover:bg-[#51c7fd] transition-all duration-300">
              <%= icon("database", class: "w-8 h-8 text-[#51c7fd] group-hover:text-[#1f1f3d]") %>
            </div>
            <h3 class="text-2xl font-semibold text-white group-hover:text-[#51c7fd] transition-colors">
              Gestion documentaire
            </h3>
          </div>
          <p class="text-gray-300 font-medium text-lg mb-3">
            Vous faites face à des volumes croissants de documents ?
          </p>
          <p class="text-gray-400 leading-relaxed text-base">
            Pharmadoc Analyzer automatise la vérification documentaire : comparaison des métadonnées, détection des incohérences et classification automatique selon les standards eTMF.
          </p>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="group p-8 lg:p-10 rounded-3xl bg-white/5 border border-white/10 hover:bg-white/10 hover:border-[#51c7fd]/50 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex flex-row items-center gap-4 mb-6">
            <div class="w-14 h-14 shrink-0 flex items-center justify-center rounded-2xl bg-[#51c7fd]/10 group-hover:scale-110 group-hover:bg-[#51c7fd] transition-all duration-300">
              <%= icon("passcheck", class: "w-8 h-8 text-[#51c7fd] group-hover:text-[#1f1f3d]") %>
            </div>
            <h3 class="text-2xl font-semibold text-white group-hover:text-[#51c7fd] transition-colors">
              Conformité réglementaire
            </h3>
          </div>
          <p class="text-gray-300 font-medium text-lg mb-3">
            Vous devez garantir la conformité FDA, EMA, ANSM ?
          </p>
          <p class="text-gray-400 leading-relaxed text-base">
            La plateforme garantit la conformité 21 CFR Part 11, ICH E6 R3, Règlement (UE) 536/2014 et principes ALCOA+. Chaque vérification bénéficie d'une traçabilité totale via piste d'audit.
          </p>
        </div>
      </div>

      <!-- Card 3 (Centrada al medio en md:col-span-2) -->
      <div class="md:col-span-2 md:w-3/4 lg:w-2/3 md:mx-auto group p-8 lg:p-10 rounded-3xl bg-white/5 border border-white/10 hover:bg-white/10 hover:border-[#51c7fd]/50 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex flex-row items-center gap-4 mb-6">
            <div class="w-14 h-14 shrink-0 flex items-center justify-center rounded-2xl bg-[#51c7fd]/10 group-hover:scale-110 group-hover:bg-[#51c7fd] transition-all duration-300">
              <%= icon("admin", class: "w-8 h-8 text-[#51c7fd] group-hover:text-[#1f1f3d]") %>
            </div>
            <h3 class="text-2xl font-semibold text-white group-hover:text-[#51c7fd] transition-colors">
              Contrôle qualité & IA spécialisée
            </h3>
          </div>
          <p class="text-gray-300 font-medium text-lg mb-3">
            Vous cherchez une IA fiable, sans approximations ?
          </p>
          <p class="text-gray-400 leading-relaxed text-base">
            Pharmadoc Analyzer est volontairement spécialisée dans l'analyse pharmaceutique. Elle apprend à partir des documents certifiés de votre laboratoire, évitant les biais des données externes — réduisant de 80% les non-conformités et le temps de revue.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<div class="footer-wave">
  <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
    <path d="M0,0 Q300,60 600,30 Q900,0 1200,30 L1200,0 L0,0 Z" fill="#1f1f3d"/>
  </svg>
</div>

<!-- SECTION : FONCTIONNALITÉS PRINCIPALES (Texto izquierda + Imágenes/Carrusel derecha) -->
<section class="w-full py-24 px-6 lg:px-16 bg-slate-50">
  <div class="max-w-7xl mx-auto">
    
    <div class="text-center mb-16">
      <h2 class="text-accent font-bold text-xl tracking-widest uppercase">
        Fonctionnalités Principales
      </h2>
      <h3 class="text-3xl lg:text-5xl font-bold mt-4 text-gray-900">
        Une plateforme, <span class="text-gradient">toutes vos opérations</span>
      </h3>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      
      <!-- Columna Izquierda: Lista de Puntos -->
      <div class="space-y-6">
        
        <div class="flex gap-4 rounded-2xl p-5 bg-white shadow-sm border border-gray-200/60 hover:shadow-md transition-shadow">
          <%= icon("data_check", class: "w-6 h-6 text-accent shrink-0 mt-1") %>
          <div>
            <h4 class="text-xl font-bold text-gray-900 mb-1">Contrôle qualité des métadonnées</h4>
            <p class="text-gray-600 leading-relaxed">
              Détection automatique des écarts entre les documents importés et le fichier de référence (dates, versions, classifications eTMF).
            </p>
          </div>
        </div>

        <div class="flex gap-4 rounded-2xl p-5 bg-white shadow-sm border border-gray-200/60 hover:shadow-md transition-shadow">
          <%= icon("sync", class: "w-6 h-6 text-accent shrink-0 mt-1") %>
          <div>
            <h4 class="text-xl font-bold text-gray-900 mb-1">Analyse de cohérence documentaire</h4>
            <p class="text-gray-600 leading-relaxed">
              Détection proactive des incohérences entre les pièces de l'étude (protocoles, amendements, eCRF, rapports de monitoring).
            </p>
          </div>
        </div>

        <div class="flex gap-4 rounded-2xl p-5 bg-white shadow-sm border border-gray-200/60 hover:shadow-md transition-shadow">
          <%= icon("userscollab", class: "w-6 h-6 text-accent shrink-0 mt-1") %>
          <div>
            <h4 class="text-xl font-bold text-gray-900 mb-1">Souveraineté & IA 100% Française</h4>
            <p class="text-gray-600 leading-relaxed">
              Solution hébergée sur OVH Cloud (France) couplée à Mistral AI. 
            </p>
          </div>
        </div>

        <div class="flex gap-4 rounded-2xl p-5 bg-white shadow-sm border border-gray-200/60 hover:shadow-md transition-shadow">
          <%= icon("energy", class: "w-6 h-6 text-accent shrink-0 mt-1") %>
          <div>
            <h4 class="text-xl font-bold text-gray-900 mb-1">Efficacité énergétique & Démarche RSE</h4>
            <p class="text-gray-600 leading-relaxed">
              Optimisation de l'empreinte carbone grâce à la mise en veille programmée du moteur d'IA la nuit et le week-end.
            </p>
          </div>
        </div>

        <div class="flex gap-4 rounded-2xl p-5 bg-white shadow-sm border border-gray-200/60 hover:shadow-md transition-shadow">
          <%= icon("doc", class: "w-6 h-6 text-accent shrink-0 mt-1") %>
          <div>
            <h4 class="text-xl font-bold text-gray-900 mb-1">Alimentation documentaire flexible</h4>
            <p class="text-gray-600 leading-relaxed">
              Dépôt direct de documents (PDF, Word, Excel) dans l'interface Aïkku ou connexion directe aux bases et eTMF existants.
            </p>
          </div>
        </div>

      </div>

      <!-- Columna Derecha: Galería / Carrusel de Capturas -->
      <div class="w-full">
        <div id="carousel" class="carousel w-full rounded-2xl shadow-2xl border border-gray-200 overflow-hidden bg-white" data-turbo="false">
          
          <div id="slide1" class="carousel-item relative w-full">
            <%= image_tag "pharmadoc/Pharmadoc (3).png", class: "w-full h-auto object-fill" %> 
            <div class="absolute left-4 right-4 top-1/2 flex -translate-y-1/2 justify-between">
              <a href="#slide3" class="btn btn-circle btn-primary btn-sm md:btn-md shadow-md">❮</a>
              <a href="#slide2" class="btn btn-circle btn-primary btn-sm md:btn-md shadow-md">❯</a>
            </div>
          </div>

          <div id="slide2" class="carousel-item relative w-full">
            <%= image_tag "pharmadoc/Pharmadoc (2).png", class: "w-full h-auto object-cover" %>
            <div class="absolute left-4 right-4 top-1/2 flex -translate-y-1/2 justify-between">
              <a href="#slide1" class="btn btn-circle btn-primary btn-sm md:btn-md shadow-md">❮</a>
              <a href="#slide3" class="btn btn-circle btn-primary btn-sm md:btn-md shadow-md">❯</a>
            </div>
          </div>

          <div id="slide3" class="carousel-item relative w-full">
            <%= image_tag "pharmadoc/Pharmadoc (1).png", class: "w-full h-auto object-cover" %>
            <div class="absolute left-4 right-4 top-1/2 flex -translate-y-1/2 justify-between">
              <a href="#slide2" class="btn btn-circle btn-primary btn-sm md:btn-md shadow-md">❮</a>
              <a href="#slide1" class="btn btn-circle btn-primary btn-sm md:btn-md shadow-md">❯</a>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<section class="text-center bg-info text-white px-8 py-16 w-full ">
  <h2 class="text-3xl lg:text-5xl  mb-6">
    Envie de voir <span class="text-gradient">Aïkku PLANN</span> en action ?
  </h2>
  <p class="max-w-xl mx-auto mb-8 leading-relaxed">
    Notre équipe vous propose des solutions adaptées à vos besoins,
    avec un accompagnement personnalisé et une assistance technique.
  </p>
  <%= link_to "Voir la démonstration →", "https://plann.aikku.eu",
        target: "_blank",
        class: "btn btn-gradient shadow-sm shadow-white/40 mt-6 h-min transition-transform hover:scale-105" %>
</section>
<div class="footer-wave">
  <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
    <path d="M0,0 Q300,60 600,30 Q900,0 1200,30 L1200,0 L0,0 Z" fill="#1f1f3d"/>
  </svg>
</div>
<section class="grid grid-cols-1 md:grid-cols-2 gap-8 px-6 pt-20 md:px-20 mb-20">
  <div class="group border border-gray-200 rounded-3xl p-8 bg-white shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-1">
    <div class="flex items-start gap-4">
      <div class="bg-blue-50 p-3 rounded-xl text-accent group-hover:bg-accent group-hover:text-white transition-colors">
        <%= icon("github", class: "w-6 h-6 ") %>
      </div>
      <div>
        <p class="text-xs font-bold text-accent uppercase tracking-widest mb-1">Développement</p>
        <h3 class="text-xl font-medium  mb-3">Code source ouvert</h3>
        <p class="text-sm text-gray-500 leading-relaxed">
          Développé en France et publié en toute transparence sur 
          <%= link_to "GitHub",
            "https://github.com/philippe-nougaillon/Planning_IAE",
            target: "_blank",
            class: "font-bold text-accent hover:text-secondary underline decoration-2 underline-offset-4" %>.
        </p>
      </div>
    </div>
  </div>
  <div class="group border border-gray-200 rounded-3xl p-8 bg-white shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-1">
    <div class="flex items-start gap-4">
      <div class="bg-blue-50 p-3 rounded-xl text-accent group-hover:bg-accent group-hover:text-white transition-colors">
        <%= icon("rocket", class: "w-6 h-6") %>
      </div>
      <div>
        <p class="text-xs font-bold text-accent uppercase tracking-widest mb-1">Support & Services</p>
        <h3 class="text-xl  font-medium mb-3">Besoin d'une fonctionnalité ?</h3>
        <p class="text-sm text-gray-500 leading-relaxed">
          Notre équipe est à votre écoute pour des besoins spécifiques.
          <%= link_to services_path, class: "block mt-2 font-semibold text-accent hover:text-secondary transition-colors group/link" do %>
            Consultez notre offre de services personnalisés →
            <span class="block mt-2 font-semibold text-accent cursor-pointer hover:underline">
            </span>
          <% end %>
        </p>
      </div>
    </div>
  </div>
</section>