</section>


<div class="footer-wave">
  <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
    <path d="M0,0 Q300,60 600,30 Q900,0 1200,30 L1200,0 L0,0 Z" fill="#1f1f3d"/>
  </svg>
</div>


<section class="w-full py-24 px-6 lg:px-16 bg-slate-50">

  <div class="max-w-7xl mx-auto">
    
    <div class="text-center mb-16">
      <h2 class="text-accent font-bold text-xl tracking-widest uppercase">
        Key Features
      </h2>

      <h3 class="text-3xl lg:text-5xl font-bold mt-4 text-gray-900">
        One platform, <span class="text-gradient">all your operations</span>
      </h3>
    </div>


    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      
      <div class="space-y-6">
        
        <div class="flex gap-4 rounded-2xl p-5 bg-white shadow-sm border border-gray-200/60 hover:shadow-md transition-shadow">
          <%= icon("data_check", class: "w-6 h-6 text-accent shrink-0 mt-1") %>

          <div>
            <h4 class="text-xl font-bold text-gray-900 mb-1">Metadata Quality Control</h4>
            <p class="text-gray-600 leading-relaxed">
              Automated discrepancy detection between imported documents and master files (dates, versions, eTMF classifications).
            </p>
          </div>
        </div>


        <div class="flex gap-4 rounded-2xl p-5 bg-white shadow-sm border border-gray-200/60 hover:shadow-md transition-shadow">
          <%= icon("sync", class: "w-6 h-6 text-accent shrink-0 mt-1") %>

          <div>
            <h4 class="text-xl font-bold text-gray-900 mb-1">Document Consistency Analysis</h4>
            <p class="text-gray-600 leading-relaxed">
              Proactive detection of inconsistencies across trial documentation (protocols, amendments, eCRF, monitoring reports).
            </p>
          </div>
        </div>


        <div class="flex gap-4 rounded-2xl p-5 bg-white shadow-sm border border-gray-200/60 hover:shadow-md transition-shadow">
          <%= icon("userscollab", class: "w-6 h-6 text-accent shrink-0 mt-1") %>

          <div>
            <h4 class="text-xl font-bold text-gray-900 mb-1">Sovereignty & 100% French AI</h4>
            <p class="text-gray-600 leading-relaxed">
              Hosted on Aïkku Cloud (France) or on-premise, powered by a Mistral AI model optimized 
              by Aïkku.
            </p>
          </div>
        </div>


        <div class="flex gap-4 rounded-2xl p-5 bg-white shadow-sm border border-gray-200/60 hover:shadow-md transition-shadow">
          <%= icon("doc", class: "w-6 h-6 text-accent shrink-0 mt-1") %>

          <div>
            <h4 class="text-xl font-bold text-gray-900 mb-1">Flexible Document Ingestion</h4>
            <p class="text-gray-600 leading-relaxed">
              Direct document upload (PDF, Word, Excel) into the Aïkku interface or seamless API integration with client production environments.
            </p>
          </div>
        </div>


        <div class="flex gap-4 rounded-2xl p-5 bg-white shadow-sm border border-gray-200/60 hover:shadow-md transition-shadow">
          <%= icon("energy", class: "w-6 h-6 text-accent shrink-0 mt-1") %>

          <div>
            <h4 class="text-xl font-bold text-gray-900 mb-1">Energy Efficiency & CSR Commitment</h4>
            <p class="text-gray-600 leading-relaxed">
              Reduced carbon footprint thanks to scheduled night and weekend standby mode for the AI engine.
            </p>
          </div>
        </div>

      </div>


      <div class="w-full">

        <div id="carousel" class="carousel w-full rounded-2xl shadow-2xl border border-gray-200 overflow-hidden bg-white" data-turbo="false">
          
          <div id="slide1" class="carousel-item relative w-full">
            <%= image_tag "pharmadoc/Pharmadoc (3).png", class: "w-full h-auto object-fill" %> 

            <div class="absolute left-4 right-4 top-1/2 flex -translate-y-1/2 justify-between">
              <a href="#slide3" class="btn btn-circle btn-primary btn-sm md:btn-md shadow-md">❮</a>
              <a href="#slide2" class="btn btn-circle btn-primary btn-sm md:btn-md shadow-md">❯</a>
            </div>
          </div>


          <div id="slide2" class="carousel-item relative w-full">
            <%= image_tag "pharmadoc/Pharmadoc (2).png", class: "w-full h-auto object-cover" %>

            <div class="absolute left-4 right-4 top-1/2 flex -translate-y-1/2 justify-between">
              <a href="#slide1" class="btn btn-circle btn-primary btn-sm md:btn-md shadow-md">❮</a>
              <a href="#slide3" class="btn btn-circle btn-primary btn-sm md:btn-md shadow-md">❯</a>
            </div>
          </div>


          <div id="slide3" class="carousel-item relative w-full">
            <%= image_tag "pharmadoc/Pharmadoc (1).png", class: "w-full h-auto object-cover" %>

            <div class="absolute left-4 right-4 top-1/2 flex -translate-y-1/2 justify-between">
              <a href="#slide2" class="btn btn-circle btn-primary btn-sm md:btn-md shadow-md">❮</a>
              <a href="#slide1" class="btn btn-circle btn-primary btn-sm md:btn-md shadow-md">❯</a>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<section class="max-w-5xl mx-auto p-6 mb-0 md:mb-20">
  <div id="video" class="items-center flex flex-col reveal delay-2">
    <div class="text-center lg:text-left">
      <h2 class="text-3xl font-medium text-accent mb-8">Aïkku IA video</h2>
    </div>
    <div class=" flex justify-center"></div>
    <%= video_tag '/videos/AïkkuIA.mp4',
          controls: true,
          class: 'w-full max-w-3xl rounded-2xl shadow-2xl',
          preload: 'none',
          poster: "New_logo.webp" %>
    </div>
  </div>
</section>


<section class="text-center bg-info text-white px-8 py-16 w-full ">

  <h2 class="text-3xl lg:text-5xl mb-6">
    Want to see <span class="text-gradient">Aïkku AI</span> in action?
  </h2>

  <p class="max-w-xl mx-auto mb-8 leading-relaxed">
    Our team offers tailored solutions to fit your needs,
    complete with personalized support and technical assistance.
  </p>

  <%= link_to "Contact Us →", contact_path,
        target: "_blank",
        class: "btn btn-gradient shadow-sm shadow-white/40 mt-6 h-min transition-transform hover:scale-105" %>

</section>


<div class="footer-wave">
  <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
    <path d="M0,0 Q300,60 600,30 Q900,0 1200,30 L1200,0 L0,0 Z" fill="#1f1f3d"/>
  </svg>
</div>


<section class="px-6 pt-20 md:px-20 mb-20">

  <div class="group w-full flex flex-col md:flex-row items-center justify-between gap-8
              border border-gray-200 rounded-3xl p-8 md:p-10 bg-white shadow-sm
              hover:shadow-md transition-all duration-300 transform hover:-translate-y-1">

    <div class="flex items-start gap-4">
      <div class="bg-blue-50 p-3 rounded-xl text-accent group-hover:bg-accent group-hover:text-white transition-colors shrink-0">
        <%= icon("rocket", class: "w-6 h-6") %>
      </div>

      <div>
        <p class="text-xs font-bold text-accent uppercase tracking-widest mb-1">Support & Services</p>
        <h3 class="text-xl font-medium mb-2">Need a custom feature?</h3>

        <p class="text-sm text-gray-500 leading-relaxed max-w-md">
          Our team is here to listen and accommodate your specific requirements.
        </p>
      </div>
    </div>
          <%= link_to services_path,
              class: "shrink-0 inline-flex items-center gap-2 bg-accent text-white font-semibold
                text-sm px-6 py-3 rounded-xl transition-colors duration-200
                hover:bg-accent/85 active:bg-accent/70
                focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" do %>
      Explore our tailored services offerings<span aria-hidden="true"> →</span>
    <% end %>

  </div>

</section>